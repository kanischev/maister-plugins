{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SDD Quality judge result",
  "type": "object",
  "additionalProperties": false,
  "required": ["criteria"],
  "properties": {
    "summary": {
      "type": "string",
      "description": "Optional one-line overall impression. Never a substitute for per-criterion scoring."
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterionId", "state"],
        "properties": {
          "criterionId": {
            "type": "string",
            "description": "A rubric criterion id (spec-fidelity, correctness, completeness, maintainability, test-evidence)."
          },
          "state": {
            "type": "string",
            "enum": ["scored", "insufficient_evidence", "not_applicable"]
          },
          "score": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 5,
            "description": "Required when state is scored; must be null otherwise."
          },
          "rationale": { "type": "string" },
          "confidence": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "evidenceRefs": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Opaque evidence item ids relied upon."
          },
          "objectiveRefs": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Objective result ids relied upon."
          }
        }
      }
    }
  }
}
